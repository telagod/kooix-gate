# Kooix Gate · 环境变量示例
# 用 `cargo run -p kgctl -- init` 生成真实密钥后填入

# ── 加密密钥（一次性生成，丢失即数据失效）─────────────────────────
KOOIX_MASTER_KEY=
KOOIX_JWT_SECRET=

# ── 基础设施 ───────────────────────────────────────────────────
KOOIX_DATABASE_URL=postgres://postgres:devpass@localhost:5432/kooix_gate
KOOIX_REDIS_URL=redis://localhost:6379/0

# ── 网络 ───────────────────────────────────────────────────────
KOOIX_LISTEN_ADDR=0.0.0.0:8000
KOOIX_PUBLIC_URL=http://localhost:8000

# ── 可选调优 ───────────────────────────────────────────────────
KOOIX_TOKEN_ACCESS_TTL_MIN=15
KOOIX_TOKEN_REFRESH_TTL_DAY=30
RUST_LOG=info,gate=debug
