# Kooix Gate · 环境变量示例
# 用 `cargo run -p kgctl -- init` 生成真实密钥后填入

# ── 加密密钥（一次性生成，丢失即数据失效）─────────────────────────
KOOIX_MASTER_KEY=
KOOIX_JWT_SECRET=

# ── 基础设施 ───────────────────────────────────────────────────
KOOIX_DATABASE_URL=postgres://postgres:devpass@localhost:5432/kooix_gate
KOOIX_REDIS_URL=redis://localhost:6379/0

# ── 网络 ───────────────────────────────────────────────────────
KOOIX_LISTEN_ADDR=0.0.0.0:8000
KOOIX_PUBLIC_URL=http://localhost:8000

# ── 可选调优 ───────────────────────────────────────────────────
KOOIX_TOKEN_ACCESS_TTL_MIN=15
KOOIX_TOKEN_REFRESH_TTL_DAY=30
RUST_LOG=info,gate=debug

# ── PostgreSQL 连接池（0.4.71 起暴露；不设则用默认值）──────────────
# 默认 max=20 / min=2 / acquire_timeout=3s / idle_timeout=600s / max_lifetime=1800s
# 生产建议：根据 worker 实例数与 PG max_connections 总盘子算
#KOOIX_DB_MAX_CONNECTIONS=20
#KOOIX_DB_MIN_CONNECTIONS=2
#KOOIX_DB_ACQUIRE_TIMEOUT_SECS=3
#KOOIX_DB_IDLE_TIMEOUT_SECS=600        # 0 = 关闭 idle 回收
#KOOIX_DB_MAX_LIFETIME_SECS=1800       # 0 = 永不轮换

# ── Worker 节流（已存在，文档化）────────────────────────────────
#KOOIX_OUTBOX_BATCH_SIZE=100
#KOOIX_OUTBOX_INTERVAL_MS=1000
#KOOIX_PRICING_SYNC_INTERVAL_SECS=86400   # 0 = 禁用
#KOOIX_INFLIGHT_SWEEP_INTERVAL_SECS=60    # 0 = 禁用

# ── WASM Plugin 持久化缓存（0.4.83 起；空则禁用）───────────────────
# 启用后冷启动从 deserialize 走，避免重新 compile 每个 wasm 模块。
# 文件名 {sha256}-wt26-0.cwasm；wasmtime 升级会自动失效旧文件。
#KOOIX_WASM_CACHE_DIR=/var/cache/kooix-gate/wasm
