      "PricingRuleRequest": {
        "type": "object",
        "required": [
          "model",
          "dimension",
          "unit",
          "rate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "channel_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "model": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "conditions": {
            "type": "object"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "effective_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "priority": {
            "type": "integer"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PricingRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "channel_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "conditions": {
            "type": "object"
          },
          "priority": {
            "type": "integer"
          }
        }
      },
      "QuotaRequest": {
        "type": "object",
        "required": [
          "scope_kind",
          "scope_id",
          "dimension",
          "limit_value"
        ],
        "properties": {
          "scope_kind": {
            "type": "string",
            "enum": [
              "org",
              "project",
              "api_key"
            ]
          },
          "scope_id": {
            "type": "string",
            "format": "uuid"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "rpm",
              "tpm",
              "concurrent",
              "daily_budget_usd",
              "monthly_budget_usd",
              "lifetime_tokens"
            ]
          },
          "model_filter": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit_value": {
            "type": [
              "string",
              "number"
            ]
          },
          "window_seconds": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Quota": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "scope_kind": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "model_filter": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit_value": {
            "type": "string"
          },
          "window_seconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "content": {}
              }
            }
          },
          "stream": {
            "type": "boolean"
          },
          "temperature": {
            "type": "number"
          },
          "top_p": {
            "type": "number"
          },
          "max_tokens": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "usage": {
            "type": "object"
          }
        }
      }
    }
  },
