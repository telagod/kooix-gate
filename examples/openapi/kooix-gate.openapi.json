{
  "openapi": "3.1.0",
  "info": {
    "title": "Kooix Gate API",
    "version": "0.4.31",
    "description": "Kooix Gate REST API. 0.4.x 起 ADR-0003 WASM Plugin v0 已落地，security.wasm.* 字段加入 manifest。"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "expires_at",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "subject",
          "current_org",
          "is_platform_admin",
          "orgs"
        ],
        "properties": {
          "subject": {
            "type": "object"
          },
          "current_org": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_platform_admin": {
            "type": "boolean"
          },
          "orgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "allowed_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateApiKeyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "plaintext": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "last4": {
            "type": "string"
          }
        }
      },
      "CreateChannelRequest": {
        "type": "object",
        "required": [
          "code",
          "provider_type",
          "base_url"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "provider_type": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic",
              "gemini",
              "azure",
              "bedrock",
              "deepseek",
              "ollama",
              "mistral",
              "cohere",
              "groq",
              "together",
              "openrouter",
              "moonshot",
              "zhipu",
              "qwen",
              "yi",
              "plugin",
              "custom",
              "http",
              "http_plugin"
            ]
          },
          "base_url": {
            "type": "string",
            "format": "uri"
          },
          "enabled": {
            "type": "boolean"
          },
          "supported_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rpm_limit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tpm_limit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "timeout_ms": {
            "type": "integer"
          },
          "max_retries": {
            "type": "integer"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_mapping": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "provider_type": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "supported_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateChannelKeyRequest": {
        "type": "object",
        "required": [
          "secret"
        ],
        "properties": {
          "secret": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          }
        }
      },
      "ChannelKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "channel_id": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "health": {
            "type": "string"
          }
        }
      },
      "CreateGroupRequest": {
        "type": "object",
        "required": [
          "name",
          "strategy"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "priority",
              "weighted_random",
              "round_robin",
              "least_conn",
              "least_latency"
            ]
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "strategy": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "AddBindingRequest": {
