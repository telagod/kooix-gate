{
  "plugin": {
    "preset": {
      "provider": "openai_compatible"
    },
    "security": {
      "max_request_bytes": 1048576,
      "max_response_bytes": 8388608,
      "max_sse_event_bytes": 1048576,
      "allow_absolute_chat_path": false,
      "outbound_allowlist": [],
      "header_redaction": [
        "authorization",
        "api-key",
        "x-api-key"
      ],
      "permissions": {
        "outbound_http": true,
        "absolute_urls": false,
        "oauth_client_credentials": false
      }
    }
  }
}
